<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_overlay_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E1E2C"
    android:gravity="center"
    android:visibility="gone">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_live_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/btn_close_voice"
            android:text="Listening..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_centerVertical="true"
            android:maxLines="3"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_close_voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel Voice Input"
            android:tint="#FFFFFF" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/voice_mic_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/iv_mic_ring"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_ring" />

        <ImageView
            android:id="@+id/iv_mic_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:background="@drawable/bg_pill_enter"
            android:padding="16dp"
            android:elevation="4dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_language_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_suggestion_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="English (US)"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap mic to finish"
        android:textColor="#A0A0A0"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

</LinearLayout>
