<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slashboard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#12131A</item>
        <item name="android:statusBarColor">#12131A</item>
        <item name="android:navigationBarColor">#12131A</item>
    </style>
    <style name="platformActivityTheme" parent="Theme.Slashboard" />
    <style name="TransparentActivityTheme" parent="Theme.Slashboard">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Keyboard Key Styles -->
    <style name="KeyboardNumberKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_key_normal</item>
        <item name="android:layout_marginHorizontal">1.5dp</item>
    </style>

    <style name="KeyboardCharKeyContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_key_normal</item>
        <item name="android:layout_marginHorizontal">1.5dp</item>
    </style>

    <style name="KeyboardCharKey">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="KeyboardSubKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:textColor">#80FFFFFF</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
